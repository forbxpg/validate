# Copy to .env and run with it: uv run --env-file .env uvicorn vld.api.main:create_app --factory
# The code never reads .env itself. Variables without a default here are required:
# the process refuses to start without them.

# PostgreSQL (required: DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://validate:validate@localhost:5432/validate
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_PRE_PING=true
# DATABASE_POOL_RECYCLE=1800

# Redis (required: REDIS_HOST)
REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Browser origins the API trusts, a JSON list (required)
MIDDLEWARE_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Logging and error tracking
# LOG_LEVEL=INFO
# LOG_JSON=true
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Integration tests only: pytest -m integration
# TEST_DATABASE_URL=postgresql+asyncpg://validate:validate@localhost:5432/test_validate
# TEST_REDIS_URL=redis://localhost:6379/15
