# Settings of the local stand. Copy once: cp backend/.env.example backend/.env
#
# `make dev` gives this file to the containers and replaces the addresses with
# in-network ones; the values below point at the ports the stand publishes on
# 127.0.0.1, for the tests and for `make api-host`.
#
# The code never reads .env itself: whoever starts a process loads it
# (docker compose, `uv run --env-file .env`). Variables without a default here
# are required: the process refuses to start without them.

# PostgreSQL (required: DATABASE_URL). The API and the worker use validate_app;
# the migrator gets validate_migrator from the Makefile and compose.
DATABASE_URL=postgresql+asyncpg://validate_app:validate_app@localhost:5452/validate
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_PRE_PING=true
# DATABASE_POOL_RECYCLE=1800

# Redis (required: REDIS_HOST)
REDIS_HOST=localhost
REDIS_PORT=6399
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

# RabbitMQ of the worker (required: BROKER_URL)
BROKER_URL=amqp://validate:validate@localhost:5692/

# Browser origins the API trusts, a JSON list (required). The single quotes keep
# the inner double quotes: without them the value is not JSON.
MIDDLEWARE_CORS_ALLOWED_ORIGINS='["http://localhost:5173"]'

# Where the process runs: local, test or production. With local, `make dev`
# starts Mailpit and points the worker at it.
APP_ENV=local

# Tokens (required: JWT_SECRET_KEY, at least 32 bytes: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-change-me-change-me-change-me
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRES_MINUTES=43200
# JWT_SESSION_EXPIRES_DAYS=90

# Password rules
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MIN_UPPERCASE=1
# PASSWORD_MIN_LOWERCASE=1

# Login only with a confirmed address
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Letters. On the stand with APP_ENV=local they go to Mailpit
# (http://localhost:8035) without any setting here. Elsewhere, without
# EMAIL_HOST they are written to the worker log (not in production).
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=465
# EMAIL_SECURITY=ssl
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM_ADDR=Validate <no-reply@example.org>
# EMAIL_PUBLIC_BASE_URL=http://localhost:5173
# EMAIL_TIMEOUT=10

# Logging and error tracking
# LOG_LEVEL=INFO
# LOG_JSON=true
# GlitchTip of the stand (make dev WITH=glitchtip): create a project at
# http://localhost:8036, copy its DSN and replace localhost:8036 with
# glitchtip-web:8000, the address the containers reach it at.
# SENTRY_DSN=http://<key>@glitchtip-web:8000/1
# SENTRY_ENVIRONMENT=local

# Secret key of the GlitchTip of the stand; any long random string.
GLITCHTIP_SECRET_KEY=local-stand-only-change-me-9f2c4e7a1b3d5f60

# Metrics of the worker (the containers bind every interface themselves)
# WORKER_METRICS_HOST=127.0.0.1
# WORKER_METRICS_PORT=9100

# Migrator (vld-migrate)
MIGRATOR_APP_ROLE=validate_app
# MIGRATOR_BACKUP_DIR=/var/backups/validate
# MIGRATOR_BACKUP_KEEP=5
# MIGRATOR_PG_DUMP=pg_dump
# MIGRATOR_LOCK_WAIT_SECONDS=60
# MIGRATOR_LOCK_TIMEOUT_MS=5000
# MIGRATOR_STATEMENT_TIMEOUT_MS=300000

# Integration tests (make test-integration sets these itself): the superuser of
# the stand, the fixtures create and drop their own test_ databases.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5452/postgres
# TEST_REDIS_URL=redis://localhost:6399/15
# pg_dump of the server's major version for the backup tests:
# MIGRATOR_PG_DUMP=/opt/homebrew/opt/postgresql@18/bin/pg_dump
