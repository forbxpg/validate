# Copy to .env and run with it: uv run --env-file .env uvicorn vld.api.main:create_app --factory
# The code never reads .env itself. Variables without a default here are required:
# the process refuses to start without them.

# PostgreSQL (required: DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://validate:validate@localhost:5432/validate
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_PRE_PING=true
# DATABASE_POOL_RECYCLE=1800

# Redis (required: REDIS_HOST)
REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Browser origins the API trusts, a JSON list (required)
MIDDLEWARE_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Where the process runs: local, test or production. Letters go to the log only
# outside production.
APP_ENV=local

# Tokens (required: JWT_SECRET_KEY, at least 32 bytes: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-change-me-change-me-change-me
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRES_MINUTES=43200
# JWT_SESSION_EXPIRES_DAYS=90

# Password rules
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MIN_UPPERCASE=1
# PASSWORD_MIN_LOWERCASE=1

# Login only with a confirmed address
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Letters. Without EMAIL_HOST they are written to the worker log (not in production).
# Mailpit of the local stand: EMAIL_HOST=localhost, EMAIL_PORT=1025.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=465
# EMAIL_SECURITY=ssl
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM_ADDR=Validate <no-reply@example.org>
# EMAIL_PUBLIC_BASE_URL=http://localhost:5173
# EMAIL_TIMEOUT=10

# Logging and error tracking
# LOG_LEVEL=INFO
# LOG_JSON=true
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Migrator (vld-migrate). Its DATABASE_URL uses the migrator role, not the API role.
MIGRATOR_APP_ROLE=validate_app
# MIGRATOR_BACKUP_DIR=/var/backups/validate
# MIGRATOR_BACKUP_KEEP=5
# MIGRATOR_PG_DUMP=pg_dump
# MIGRATOR_LOCK_WAIT_SECONDS=60
# MIGRATOR_LOCK_TIMEOUT_MS=5000
# MIGRATOR_STATEMENT_TIMEOUT_MS=300000

# Integration tests only: pytest -m integration
# TEST_DATABASE_URL=postgresql+asyncpg://validate:validate@localhost:5432/test_validate
# TEST_REDIS_URL=redis://localhost:6379/15
# pg_dump of the server's major version for the backup tests:
# MIGRATOR_PG_DUMP=/opt/homebrew/opt/postgresql@18/bin/pg_dump
