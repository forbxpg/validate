{
  "include": ["packages", "apps"],
  "exclude": ["**/.venv", "**/__pycache__", "**/.ruff_cache"],
  "pythonVersion": "3.13",
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "recommended",
  "reportMissingTypeStubs": false,
  "reportUnnecessaryTypeIgnoreComment": "warning",
  // Fires on `from dishka import provide`: dishka types ProvideSource with a bare
  // classmethod. Unknown values are still caught where used, by
  // reportUnknownMemberType and reportUnknownArgumentType.
  "reportUnknownVariableType": "none",
  "executionEnvironments": [
    {
      "root": "packages/auth/tests",
      "extraPaths": ["packages/auth/tests/support"],
      "reportAny": false,
      "reportPrivateUsage": false,
      "reportUnknownMemberType": false,
      "reportUnusedCallResult": false
    },
    {
      "root": "apps/worker/tests",
      "extraPaths": ["packages/auth/tests/support"],
      "reportAny": false,
      "reportPrivateUsage": false,
      "reportUnknownMemberType": false,
      "reportUnusedCallResult": false
    },
    {
      "root": "packages/crossref/tests",
      "extraPaths": ["packages/crossref/tests/support"],
      "reportAny": false,
      "reportPrivateUsage": false,
      "reportUnknownMemberType": false,
      "reportUnusedCallResult": false
    },
    {
      "root": "packages/core/tests",
      "reportAny": false,
      "reportPrivateUsage": false,
      "reportUnknownMemberType": false,
      "reportUnusedCallResult": false
    },
    {
      "root": "packages/web/tests",
      "reportAny": false,
      "reportPrivateUsage": false,
      "reportUnknownMemberType": false,
      "reportUnusedCallResult": false
    },
    {
      "root": "apps/api/tests",
      "reportAny": false,
      "reportPrivateUsage": false,
      "reportUnknownMemberType": false,
      "reportUnusedCallResult": false
    },
    {
      "root": "apps/migrator/tests",
      "reportAny": false,
      "reportPrivateUsage": false,
      "reportUnknownMemberType": false,
      "reportUnusedCallResult": false
    },
    { "root": "packages" },
    { "root": "apps" }
  ]
}
